{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\ncontroller_1 = Controller(PRIMARY)\nservo_b = Servo(brain.three_wire_port.b)\nservo_a = Servo(brain.three_wire_port.a)\nleft_drive_smart = Motor55(Ports.PORT3, False)\nright_drive_smart = Motor55(Ports.PORT8, True)\nshoulder_motor = Motor55(Ports.PORT6, True)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n#region Project variables\n# TESTING only checks the robot. It never drives it.\nservoAdegree = 50\nlast_servo_command = None\narm_servo_degree = 50\narm_servo_last = None\ncheck_passed = False\nx_was_down = False\nresult_pages = []\npage_index = 0\npage_ms = 0\nresults_done = False\nreview_ready = False\nreview_up_was = False\nreview_down_was = False\nlast_shown = None\nremote_control_code_enabled = False\n#endregion Project variables\n\n#region Controller screen\ndef fit(text):\n    text = str(text)\n    if len(text) > 19:\n        text = text[:19]\n    pad = 19 - len(text)\n    if pad > 0:\n        text = text + \" \" * pad\n    return text\n\ndef show_lines(line1, line2, line3):\n    global last_shown\n    a = fit(line1)\n    b = fit(line2)\n    c = fit(line3)\n    shown = (a, b, c)\n    if shown == last_shown:\n        return\n    last_shown = shown\n    brain.screen.set_font(FontType.MONO20)\n    controller_1.screen.set_cursor(1, 1)\n    controller_1.screen.print(a)\n    controller_1.screen.set_cursor(2, 1)\n    controller_1.screen.print(b)\n    controller_1.screen.set_cursor(3, 1)\n    controller_1.screen.print(c)\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(a)\n    brain.screen.set_cursor(2, 1)\n    brain.screen.print(b)\n    brain.screen.set_cursor(3, 1)\n    brain.screen.print(c)\n\ndef whole(value):\n    return str(int(value + 0.5))\n\ndef tenth(value):\n    scaled = int(value * 10 + 0.5)\n    return str(scaled // 10) + \".\" + str(scaled % 10)\n\n#endregion Controller screen\n\n#region Hand (3-wire B)\ndef command_servo():\n    global servoAdegree, last_servo_command\n    if servoAdegree > 100:\n        servoAdegree = 100\n    if servoAdegree < 0:\n        servoAdegree = 0\n    if servoAdegree != last_servo_command:\n        servo_b.set_position(servoAdegree - 50.0, DEGREES)\n        last_servo_command = servoAdegree\n\n\n#endregion Hand\n\n#region Wrist (3-wire A)\ndef command_arm_servo():\n    global arm_servo_degree, arm_servo_last\n    if arm_servo_degree > 100:\n        arm_servo_degree = 100\n    if arm_servo_degree < 0:\n        arm_servo_degree = 0\n    if arm_servo_degree != arm_servo_last:\n        spot = arm_servo_degree - 50.0\n        servo_a.set_position(spot, DEGREES)\n        arm_servo_last = arm_servo_degree\n\n#endregion Wrist\n\n#region Systems check\ndef battery_volts():\n    try:\n        return brain.battery.voltage(MV) / 1000.0\n    except:\n        return None\n\ndef battery_amps():\n    try:\n        return brain.battery.current()\n    except:\n        return None\n\ndef watch_battery(ms, max_a, min_v):\n    start = brain.timer.time(MSEC)\n    stage_a = None\n    while brain.timer.time(MSEC) - start < ms:\n        a = battery_amps()\n        v = battery_volts()\n        if a is not None:\n            if max_a is None or a > max_a:\n                max_a = a\n            if stage_a is None or a > stage_a:\n                stage_a = a\n        if v is not None:\n            if min_v is None or v < min_v:\n                min_v = v\n        wait(50, MSEC)\n    return max_a, min_v, stage_a\n\ndef amp_text(label, amps):\n    if amps is None:\n        return label + \" n/a\"\n    return label + \" \" + tenth(amps) + \"A\"\n\ndef volt_text(label, volts):\n    if volts is None:\n        return label + \" n/a\"\n    return label + \" \" + tenth(volts) + \"V\"\n\ndef sag_text(rest, low):\n    if rest is None or low is None:\n        return \"Sag n/a\"\n    sag = rest - low\n    if sag < 0:\n        sag = 0\n    return \"Sag \" + tenth(sag) + \"V\"\n\ndef higher_amp(peak, sample):\n    if sample is None:\n        return peak\n    if peak is None or sample > peak:\n        return sample\n    return peak\n\ndef run_systems_check():\n    global check_passed, remote_control_code_enabled, servoAdegree\n    global arm_servo_degree\n    global result_pages, page_index, page_ms\n    global results_done, review_ready\n    remote_control_code_enabled = False\n    results_done = False\n    review_ready = False\n    left_drive_smart.stop()\n    right_drive_smart.stop()\n    shoulder_motor.stop()\n    show_lines(\"Checking now\", \"Please wait\", \"Wheels will twitch\")\n\n    faults = []\n    try:\n        brain_pct = brain.battery.capacity()\n    except:\n        brain_pct = 0\n    rest_v = battery_volts()\n    brain_v = rest_v\n    if brain_v is None:\n        brain_v = 0\n    allow_spin = True\n    if brain_pct < 15 or brain_v < 10.5:\n        faults.append(\"Brain battery low\")\n        allow_spin = False\n\n    rest_a = battery_amps()\n    max_a = rest_a\n    min_v = rest_v\n    wheels_a = None\n    shoulder_a = None\n    servos_a = None\n    brain_line = \"Brain \" + whole(brain_pct) + \"% \" + tenth(brain_v) + \"V\"\n    rest_line = amp_text(\"Rest\", rest_a)\n    show_lines(brain_line, rest_line, \"Checking motors\")\n    max_a, min_v, idle_a = watch_battery(500, max_a, min_v)\n    rest_a = higher_amp(rest_a, idle_a)\n    rest_line = amp_text(\"Rest\", rest_a)\n\n    if allow_spin:\n        try:\n            left_drive_smart.set_velocity(30, PERCENT)\n            left_drive_smart.spin(FORWARD)\n            right_drive_smart.set_velocity(30, PERCENT)\n            right_drive_smart.spin(FORWARD)\n            max_a, min_v, wheels_a = watch_battery(350, max_a, min_v)\n        finally:\n            left_drive_smart.stop()\n            right_drive_smart.stop()\n        left_line = \"L sent\"\n        right_line = \"R sent\"\n    else:\n        left_drive_smart.stop()\n        right_drive_smart.stop()\n        left_line = \"L held\"\n        right_line = \"R held\"\n    if allow_spin:\n        try:\n            shoulder_motor.set_velocity(30, PERCENT)\n            shoulder_motor.spin(FORWARD)\n            max_a, min_v, shoulder_a = watch_battery(350, max_a, min_v)\n        finally:\n            shoulder_motor.stop()\n        shoulder_line = \"Shoulder sent\"\n    else:\n        shoulder_motor.stop()\n        shoulder_line = \"Shoulder held\"\n    show_lines(left_line, right_line, \"Checking hand\")\n\n    servoAdegree = 40\n    command_servo()\n    max_a, min_v, stage_a = watch_battery(300, max_a, min_v)\n    servos_a = higher_amp(servos_a, stage_a)\n    servoAdegree = 60\n    command_servo()\n    max_a, min_v, stage_a = watch_battery(300, max_a, min_v)\n    servos_a = higher_amp(servos_a, stage_a)\n    servoAdegree = 50\n    command_servo()\n\n    show_lines(\"Checking arm\", \"Hand then wrist\", shoulder_line)\n\n    arm_servo_degree = 40\n    command_arm_servo()\n    max_a, min_v, stage_a = watch_battery(300, max_a, min_v)\n    servos_a = higher_amp(servos_a, stage_a)\n    arm_servo_degree = 60\n    command_arm_servo()\n    max_a, min_v, stage_a = watch_battery(300, max_a, min_v)\n    servos_a = higher_amp(servos_a, stage_a)\n    arm_servo_degree = 50\n    command_arm_servo()\n    max_a, min_v, stage_a = watch_battery(200, max_a, min_v)\n    servos_a = higher_amp(servos_a, stage_a)\n\n    # Each system and whether it is ready. Motors and servos cannot report back,\n    # so \"ready\" means the battery was OK and the command was sent.\n    system_results = [\n        [\"Battery\", allow_spin],\n        [\"L wheel\", allow_spin],\n        [\"R wheel\", allow_spin],\n        [\"Shoulder\", allow_spin],\n        [\"Hand\", True],\n        [\"Wrist\", True],\n    ]\n    ready_count = 0\n    for item in system_results:\n        if item[1]:\n            ready_count = ready_count + 1\n    summary_line = \"Systems ready \" + str(ready_count) + \"/\" + str(len(system_results))\n\n    drain_line = amp_text(\"Max drain\", max_a)\n    low_line = volt_text(\"Low V\", min_v)\n    rest_v_line = volt_text(\"Rest\", rest_v)\n    sag_line = sag_text(rest_v, min_v)\n    wheels_line = amp_text(\"Wheels\", wheels_a)\n    shoulder_amp_line = amp_text(\"Shoulder\", shoulder_a)\n    servos_line = amp_text(\"Servos\", servos_a)\n\n    if len(faults) == 0:\n        check_passed = True\n        title = \"CHECK PASSED\"\n        result_pages = [\n            [\"CHECK PASSED\", summary_line, \"Up/Dn  X again\"],\n            [title, brain_line, rest_line],\n            [title, drain_line, low_line],\n            [title, rest_v_line, sag_line],\n            [title, wheels_line, shoulder_amp_line],\n            [title, servos_line, \"\"],\n            [title, left_line, right_line],\n            [title, shoulder_line, \"Hand moved\"],\n            [title, \"Wrist moved\", \"\"],\n        ]\n        page = warning_page()\n        if page is not None:\n            result_pages.append(page)\n        controller_1.rumble(\"..\")\n    else:\n        check_passed = False\n        remote_control_code_enabled = False\n        left_drive_smart.stop()\n        right_drive_smart.stop()\n        shoulder_motor.stop()\n        title = \"CHECK FAILED\"\n        result_pages = [[\"CHECK FAILED\", summary_line, \"Up/Dn pages X retry\"]]\n        for fault in faults:\n            result_pages.append([title, \"Needs a fix\", fault])\n        result_pages.append([title, brain_line, rest_line])\n        result_pages.append([title, drain_line, low_line])\n        result_pages.append([title, rest_v_line, sag_line])\n        result_pages.append([title, wheels_line, shoulder_amp_line])\n        result_pages.append([title, servos_line, \"\"])\n        result_pages.append([\"CHECK FAILED\", \"Press X to retry\", \"\"])\n        controller_1.rumble(\"---\")\n    page_index = 0\n    page_ms = 0\n\ndef show_review_page():\n    if len(result_pages) == 0:\n        return\n    page = result_pages[page_index]\n    total = len(result_pages)\n    n = page_index + 1\n    line1 = \"Pg \" + str(n) + \"/\" + str(total) + \" \" + page[0]\n    if len(line1) > 19:\n        # Two-digit page counts do not fit with CHECK in front.\n        line1 = \"Pg \" + str(n) + \"/\" + str(total) + \" \" + page[0].replace(\"CHECK \", \"\")\n    show_lines(line1, page[1], page[2])\n\n\ndef review_results():\n    # Up and Down flip through the result pages. X runs the check again.\n    global page_index\n    global review_ready, review_up_was, review_down_was\n    if len(result_pages) == 0:\n        return\n    up = controller_1.buttonUp.pressing()\n    down = controller_1.buttonDown.pressing()\n    if not review_ready:\n        review_up_was = up\n        review_down_was = down\n        review_ready = True\n        show_review_page()\n        return\n    if up and not review_up_was:\n        page_index = page_index - 1\n        if page_index < 0:\n            page_index = len(result_pages) - 1\n    elif down and not review_down_was:\n        page_index = page_index + 1\n        if page_index >= len(result_pages):\n            page_index = 0\n    review_up_was = up\n    review_down_was = down\n    show_review_page()\n#endregion Systems check\n\n#region Warnings\ndef collect_warnings():\n    problems = []\n    try:\n        brain_pct = brain.battery.capacity()\n    except:\n        brain_pct = None\n    try:\n        brain_v = brain.battery.voltage(MV) / 1000.0\n    except:\n        brain_v = None\n    if (brain_pct is not None and brain_pct < 30) or (brain_v is not None and brain_v < 11.5):\n        problems.append(\"Battery getting low\")\n    return problems\n\ndef warning_page():\n    problems = collect_warnings()\n    if len(problems) == 0:\n        return None\n    return [\"Warning\", problems[0], \"Charge it soon\"]\n\n#endregion Warnings\n\n#region Startup\ndef when_started1():\n    global x_was_down\n    # Everything stays still. Only the systems check moves anything.\n    left_drive_smart.set_stopping(BRAKE)\n    right_drive_smart.set_stopping(BRAKE)\n    shoulder_motor.set_stopping(BRAKE)\n    left_drive_smart.stop()\n    right_drive_smart.stop()\n    shoulder_motor.stop()\n    x_was_down = controller_1.buttonX.pressing()\n    controller_1.screen.clear_screen()\n    brain.screen.clear_screen()\n    show_lines(\"TESTING  X=check\", \"Robot will not\", \"drive in this code\")\n    while True:\n        x_down = controller_1.buttonX.pressing()\n        if x_down and not x_was_down:\n            run_systems_check()\n        x_was_down = x_down\n        review_results()\n        wait(20, MSEC)\n\nwhen_started1()\n#endregion Startup\n","textLanguage":"python","robotConfig":[{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"","id":"primary"},"triportSourcePort":22},{"port":[2],"name":"servo_b","customName":false,"deviceType":"Servo","deviceClass":"servo","setting":{"id":"partner"},"triportSourcePort":22},{"port":[1],"name":"servo_a","customName":false,"deviceType":"Servo","deviceClass":"servo","setting":{"id":"partner"},"triportSourcePort":22},{"port":[3],"name":"left_drive_smart","customName":true,"deviceType":"MC55","deviceClass":"motor55","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":null},{"port":[8],"name":"right_drive_smart","customName":true,"deviceType":"MC55","deviceClass":"motor55","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":null},{"port":[6],"name":"shoulder_motor","customName":true,"deviceType":"MC55","deviceClass":"motor55","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":null}],"slot":1,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}