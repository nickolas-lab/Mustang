{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\ncontroller_1 = Controller(PRIMARY)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n#region Ports\n# Change a port here and nowhere else.\n# Motors plug into Brain ports 1-21. Servos plug into 3-wire ports A-H.\n# REVERSED: if a motor spins the wrong way, flip True/False.\n# Keep these the same in the COMPETITION and TESTING programs.\nLEFT_WHEEL_PORT = Ports.PORT5\nLEFT_WHEEL_REVERSED = True\nRIGHT_WHEEL_PORT = Ports.PORT8\nRIGHT_WHEEL_REVERSED = False\nSHOULDER_PORT = Ports.PORT6\nSHOULDER_REVERSED = True\n\nSERVO_1_PORT = brain.three_wire_port.a\nSERVO_2_PORT = brain.three_wire_port.b\nSERVO_3_PORT = brain.three_wire_port.c\nSERVO_4_PORT = brain.three_wire_port.d\n\nleft_drive_smart = Motor55(LEFT_WHEEL_PORT, LEFT_WHEEL_REVERSED)\nright_drive_smart = Motor55(RIGHT_WHEEL_PORT, RIGHT_WHEEL_REVERSED)\nshoulder_motor = Motor55(SHOULDER_PORT, SHOULDER_REVERSED)\nservo_1 = Servo(SERVO_1_PORT)\nservo_2 = Servo(SERVO_2_PORT)\nservo_3 = Servo(SERVO_3_PORT)\nservo_4 = Servo(SERVO_4_PORT)\n#endregion Ports\n\n#region Servo settings\n# Four servo slots. Set \"on\" to False for a servo that is not plugged in.\n# step = how far one step moves (0-100 scale), step_ms = time between steps.\n# slow_ends = take smaller steps near 0 and 100.\nSERVOS = {\n    1: {\"device\": servo_1, \"on\": True,  \"step\": 10, \"step_ms\": 50, \"start\": 50, \"slow_ends\": True},\n    2: {\"device\": servo_2, \"on\": False, \"step\": 2,  \"step_ms\": 20, \"start\": 50, \"slow_ends\": False},\n    3: {\"device\": servo_3, \"on\": False, \"step\": 5,  \"step_ms\": 50, \"start\": 50, \"slow_ends\": True},\n    4: {\"device\": servo_4, \"on\": False, \"step\": 5,  \"step_ms\": 50, \"start\": 50, \"slow_ends\": True},\n}\n#endregion Servo settings\n\n#region Driver settings\n# COMPETITION: pick a driver, then drive. No systems check, no test pages.\n# Each driver has a speed and a button layout. Change a driver by editing its block.\n# For each servo: \"minus\" moves toward 0, \"plus\" moves toward 100,\n# \"center\" = True lets both buttons together put that servo back in the middle.\n# A servo with None for its buttons has no buttons yet.\n\n# Driver 1: Decided. Copy of Jack's\nDRIVER_1 = {\n    \"name\": \"Driver 1\",\n    \"speed\": 100,\n    \"shoulder_up\": controller_1.buttonA,\n    \"shoulder_down\": controller_1.buttonB,\n    \"servos\": {\n        1: {\"minus\": controller_1.buttonL2, \"plus\": controller_1.buttonR2, \"center\": True},\n        2: {\"minus\": controller_1.buttonL1, \"plus\": controller_1.buttonR1, \"center\": True},\n        3: {\"minus\": controller_1.buttonDown, \"plus\": controller_1.buttonUp, \"center\": True},\n        4: {\"minus\": None, \"plus\": None, \"center\": False},\n    },\n}\n\n# Driver 2: Decided. Copy of Jack's.\nDRIVER_2 = {\n    \"name\": \"Driver 2\",\n    \"speed\": 100,\n    \"shoulder_up\": controller_1.buttonA,\n    \"shoulder_down\": controller_1.buttonB,\n    \"servos\": {\n        1: {\"minus\": controller_1.buttonL2, \"plus\": controller_1.buttonR2, \"center\": True},\n        2: {\"minus\": controller_1.buttonL1, \"plus\": controller_1.buttonR1, \"center\": True},\n        3: {\"minus\": controller_1.buttonDown, \"plus\": controller_1.buttonUp, \"center\": True},\n        4: {\"minus\": None, \"plus\": None, \"center\": False},\n    },\n}\n\n# Driver 3: Decided. Copy of Jack's.\nDRIVER_3 = {\n    \"name\": \"Driver 3\",\n    \"speed\": 100,\n    \"shoulder_up\": controller_1.buttonA,\n    \"shoulder_down\": controller_1.buttonB,\n    \"servos\": {\n        1: {\"minus\": controller_1.buttonL2, \"plus\": controller_1.buttonR2, \"center\": True},\n        2: {\"minus\": controller_1.buttonL1, \"plus\": controller_1.buttonR1, \"center\": True},\n        3: {\"minus\": controller_1.buttonDown, \"plus\": controller_1.buttonUp, \"center\": True},\n        4: {\"minus\": None, \"plus\": None, \"center\": False},\n    },\n}\n\n# Driver 4: Decided. Copy of Nick's.\nDRIVER_4 = {\n    \"name\": \"Driver 4\",\n    \"speed\": 100,\n    \"shoulder_up\": controller_1.buttonL2,\n    \"shoulder_down\": controller_1.buttonR2,\n    \"servos\": {\n        1: {\"minus\": controller_1.buttonUp, \"plus\": controller_1.buttonDown, \"center\": True},\n        2: {\"minus\": controller_1.buttonL1, \"plus\": controller_1.buttonR1, \"center\": False},\n        3: {\"minus\": controller_1.buttonLeft, \"plus\": controller_1.buttonRight, \"center\": True},\n        4: {\"minus\": None, \"plus\": None, \"center\": False},\n    },\n}\n#endregion Driver settings\n\n#region Project variables\nARM_UP_SPEED = 70\nARM_DOWN_SPEED = 50\nMATCH_MS = 180000\nDEADBAND = 5\n# Each quarter of the joystick circle is split in half (45 degrees).\n# Within STRAIGHT_ZONE degrees of straight up or down, the robot drives straight.\n# Past that, toward the side, it turns in place. 45 = exactly half of each quarter.\nSTRAIGHT_ZONE = 45\n# How fast the wheels are allowed to speed up. The number is how much speed (out of 100)\n# can be added every 20 ms. 20 = full speed in a tenth of a second. 100 = no limit.\n# Slowing down and stopping are always instant.\nDRIVE_RAMP = 20\n# Stop/drive needs BOTH of these buttons pressed together.\nSTOP_BUTTON_1 = controller_1.buttonX\nSTOP_BUTTON_2 = controller_1.buttonY\n\ndriver = None\nspeed_scale = 100\nremote_control_code_enabled = False\ndrive_stopped = False\nSERVO_NUMBERS = (1, 2, 3, 4)\nstraight_ratio = math.tan(math.radians(STRAIGHT_ZONE))\nservo_pos = {1: 50, 2: 50, 3: 50, 4: 50}\nservo_last = {1: None, 2: None, 3: None, 4: None}\nservo_step_time = {1: 0, 2: 0, 3: 0, 4: 0}\nservo_both_held = {1: False, 2: False, 3: False, 4: False}\nlast_arm_cmd = None\npick_ready = False\na_was_down = False\nb_was_down = False\ny_was_down = False\nx_was_down = False\nstop_was_down = False\narm_ready = False\nmatch_start = -1\nmatch_over = False\nrumbled_15 = False\nclock_mark = None\nlast_lines = [None, None, None]\n#endregion Project variables\n\n#region Screen\ndef fit(text):\n    text = str(text)\n    if len(text) > 19:\n        text = text[:19]\n    pad = 19 - len(text)\n    if pad > 0:\n        text = text + \" \" * pad\n    return text\n\ndef show_lines(line1, line2, line3):\n    # Only a line that changed is sent. Sending to the controller screen is slow,\n    # so this keeps the buttons from lagging when the screen updates.\n    lines = (line1, line2, line3)\n    for i in range(3):\n        text = fit(lines[i])\n        if text != last_lines[i]:\n            last_lines[i] = text\n            controller_1.screen.set_cursor(i + 1, 1)\n            controller_1.screen.print(text)\n            brain.screen.set_cursor(i + 1, 1)\n            brain.screen.print(text)\n#endregion Screen\n\n#region Servos\ndef command_servo(n):\n    if not SERVOS[n][\"on\"]:\n        return\n    if servo_pos[n] > 100:\n        servo_pos[n] = 100\n    if servo_pos[n] < 0:\n        servo_pos[n] = 0\n    if servo_pos[n] != servo_last[n]:\n        SERVOS[n][\"device\"].set_position(servo_pos[n] - 50.0, DEGREES)\n        servo_last[n] = servo_pos[n]\n\ndef servo_control(n, now):\n    # Hold minus or plus to step the servo. Both together recenter it only if\n    # this driver allows it. After both are pressed, the servo waits until both are let go.\n    if not SERVOS[n][\"on\"]:\n        return\n    keys = driver[\"servos\"][n]\n    if keys[\"minus\"] is None or keys[\"plus\"] is None:\n        return\n    minus = keys[\"minus\"].pressing()\n    plus = keys[\"plus\"].pressing()\n    if minus and plus:\n        if not servo_both_held[n] and keys[\"center\"]:\n            servo_pos[n] = 50\n            command_servo(n)\n        servo_both_held[n] = True\n    elif servo_both_held[n]:\n        if not minus and not plus:\n            servo_both_held[n] = False\n    else:\n        s = SERVOS[n]\n        step = 0\n        if plus:\n            step = s[\"step\"]\n            if s[\"slow_ends\"] and servo_pos[n] >= 85:\n                step = min(step, 5)\n        elif minus:\n            step = -s[\"step\"]\n            if s[\"slow_ends\"] and servo_pos[n] <= 15:\n                step = -min(s[\"step\"], 5)\n        if step != 0 and now - servo_step_time[n] >= s[\"step_ms\"]:\n            servo_pos[n] = servo_pos[n] + step\n            servo_step_time[n] = now\n            command_servo(n)\n#endregion Servos\n\n#region Shoulder\ndef send_arm(cmd, last):\n    if cmd == last:\n        return last\n    if cmd == \"stop\":\n        shoulder_motor.stop()\n    elif cmd == \"up\":\n        shoulder_motor.set_velocity(ARM_UP_SPEED, PERCENT)\n        shoulder_motor.spin(FORWARD)\n    else:\n        shoulder_motor.set_velocity(ARM_DOWN_SPEED, PERCENT)\n        shoulder_motor.spin(REVERSE)\n    return cmd\n\ndef arm_control():\n    global last_arm_cmd, arm_ready\n    up = driver[\"shoulder_up\"].pressing()\n    down = driver[\"shoulder_down\"].pressing()\n    if not arm_ready:\n        # A button still held from the driver pick must be let go first.\n        if not up and not down:\n            arm_ready = True\n        up = False\n        down = False\n    if up and not down:\n        last_arm_cmd = send_arm(\"up\", last_arm_cmd)\n    elif down and not up:\n        last_arm_cmd = send_arm(\"down\", last_arm_cmd)\n    else:\n        last_arm_cmd = send_arm(\"stop\", last_arm_cmd)\n#endregion Shoulder\n\n#region Driver pick\ndef start_driver(profile):\n    global driver, speed_scale, remote_control_code_enabled\n    global match_start, match_over, rumbled_15, clock_mark, arm_ready\n    driver = profile\n    arm_ready = False\n    speed_scale = profile[\"speed\"]\n    for n in SERVO_NUMBERS:\n        # A button still held from the pick must be let go before it moves anything.\n        servo_both_held[n] = True\n        servo_pos[n] = SERVOS[n][\"start\"]\n        command_servo(n)\n    match_start = brain.timer.time(MSEC)\n    match_over = False\n    rumbled_15 = False\n    clock_mark = None\n    remote_control_code_enabled = True\n\ndef pick_driver():\n    global pick_ready, a_was_down, b_was_down, y_was_down, x_was_down\n    a_down = controller_1.buttonA.pressing()\n    b_down = controller_1.buttonB.pressing()\n    y_down = controller_1.buttonY.pressing()\n    x_down = controller_1.buttonX.pressing()\n    if not pick_ready:\n        # A button already held when the screen appears does not count.\n        a_was_down = a_down\n        b_was_down = b_down\n        y_was_down = y_down\n        x_was_down = x_down\n        show_lines(\"Pick your initials\", \"A=JT A=CR B=MC\", \"Y=KT X=DJ\")\n        pick_ready = True\n        return\n    if a_down and not a_was_down:\n        start_driver(DRIVER_1)\n    elif b_down and not b_was_down:\n        start_driver(DRIVER_2)\n    elif y_down and not y_was_down:\n        start_driver(DRIVER_3)\n    elif x_down and not x_was_down:\n        start_driver(DRIVER_4)\n    a_was_down = a_down\n    b_was_down = b_down\n    y_was_down = y_down\n    x_was_down = x_down\n#endregion Driver pick\n\n#region Drive stop\ndef stop_combo():\n    return STOP_BUTTON_1.pressing() and STOP_BUTTON_2.pressing()\n\ndef toggle_drive_stop():\n    global drive_stopped, clock_mark\n    drive_stopped = not drive_stopped\n    clock_mark = None\n    if drive_stopped:\n        left_drive_smart.stop()\n        right_drive_smart.stop()\n#endregion Drive stop\n\n#region Match clock\ndef seconds_left(now):\n    if match_start < 0:\n        return MATCH_MS // 1000\n    remain = MATCH_MS - (now - match_start)\n    if remain <= 0:\n        return 0\n    return int((remain + 999) // 1000)\n\ndef clock_text(left):\n    minutes = int(left // 60)\n    seconds = int(left % 60)\n    sec = str(seconds)\n    if seconds < 10:\n        sec = \"0\" + sec\n    return \"Time \" + str(minutes) + \":\" + sec\n\ndef show_clock_screen(left):\n    global clock_mark\n    mark = (left, drive_stopped, match_over)\n    if mark == clock_mark:\n        return\n    clock_mark = mark\n    line2 = driver[\"name\"] + \" \" + str(driver[\"speed\"]) + \"%\"\n    if drive_stopped:\n        line3 = \"X+Y to drive\"\n    elif match_over:\n        line3 = \"Match over\"\n    else:\n        line3 = \"X+Y to stop\"\n    show_lines(clock_text(left), line2, line3)\n#endregion Match clock\n\n#region Drive\n# Either stick drives the robot by itself. If both are pushed, the one pushed farther wins.\n# The stick circle is cut into four zones:\n#   top zone    = forward, straight      bottom zone = reverse, straight\n#   right zone  = turn right in place    left zone   = turn left in place\n# So a stick pushed forward and a little to the side still drives straight.\ndef clamp(v):\n    if v > 100:\n        return 100\n    if v < -100:\n        return -100\n    return v\n\ndef pick_stick():\n    # Returns (y, x) for the stick pushed farther from the middle.\n    y1 = controller_1.axis3.position()\n    x1 = controller_1.axis4.position()\n    y2 = controller_1.axis2.position()\n    x2 = controller_1.axis1.position()\n    if y1 * y1 + x1 * x1 >= y2 * y2 + x2 * x2:\n        return y1, x1\n    return y2, x2\n\ndef stick_to_drive(y, x):\n    # Returns (forward, turn). Only one of them is ever non-zero.\n    if abs(y) < DEADBAND and abs(x) < DEADBAND:\n        return 0, 0\n    if abs(x) <= abs(y) * straight_ratio:\n        return y, 0\n    return 0, x\n\ndef ramp(target, last):\n    # Stopping and slowing down happen right away. Speeding up is limited by\n    # DRIVE_RAMP, and a wheel going the other way starts again from zero.\n    # This keeps a hard reverse from yanking the battery down or tipping the robot.\n    if last is None:\n        last = 0\n    if target == 0:\n        return 0\n    if target > 0:\n        if last < 0:\n            last = 0\n        if target > last + DRIVE_RAMP:\n            return last + DRIVE_RAMP\n        return target\n    if last > 0:\n        last = 0\n    if target < last - DRIVE_RAMP:\n        return last - DRIVE_RAMP\n    return target\n\ndef set_wheel(motor, speed, last):\n    if speed == last:\n        return last\n    if speed == 0:\n        motor.stop()\n    else:\n        motor.set_velocity(abs(speed), PERCENT)\n        if speed > 0:\n            motor.spin(FORWARD)\n        else:\n            motor.spin(REVERSE)\n    return speed\n\ndef drive_loop_body():\n    last_l = None\n    last_r = None\n    while True:\n        try:\n            l = 0\n            r = 0\n            if remote_control_code_enabled and not drive_stopped:\n                y, x = pick_stick()\n                forward, turn = stick_to_drive(y, x)\n                l = int(clamp(forward - turn) * speed_scale / 100)\n                r = int(clamp(forward + turn) * speed_scale / 100)\n            last_l = set_wheel(left_drive_smart, ramp(l, last_l), last_l)\n            last_r = set_wheel(right_drive_smart, ramp(r, last_r), last_r)\n        except:\n            left_drive_smart.stop()\n            right_drive_smart.stop()\n            last_l = 0\n            last_r = 0\n        wait(20, MSEC)\n\ndef drive_loop():\n    try:\n        drive_loop_body()\n    finally:\n        try:\n            left_drive_smart.stop()\n        except:\n            pass\n        try:\n            right_drive_smart.stop()\n        except:\n            pass\n#endregion Drive\n\n#region Startup\ndef main_pass():\n    global stop_was_down, match_over, rumbled_15\n    stop_down = stop_combo()\n    if driver is None:\n        pick_driver()\n    else:\n        if stop_down and not stop_was_down:\n            toggle_drive_stop()\n        now = brain.timer.time(MSEC)\n        left = seconds_left(now)\n        if not match_over:\n            if left <= 15 and not rumbled_15:\n                controller_1.rumble(\"-\")\n                rumbled_15 = True\n            if left == 0:\n                match_over = True\n                controller_1.rumble(\"---\")\n        for n in SERVO_NUMBERS:\n            servo_control(n, now)\n        arm_control()\n        show_clock_screen(left)\n    stop_was_down = stop_down\n\ndef when_started1():\n    global stop_was_down, last_arm_cmd\n    left_drive_smart.set_stopping(BRAKE)\n    right_drive_smart.set_stopping(BRAKE)\n    shoulder_motor.set_stopping(BRAKE)\n    left_drive_smart.stop()\n    right_drive_smart.stop()\n    shoulder_motor.stop()\n    stop_was_down = stop_combo()\n    controller_1.screen.clear_screen()\n    brain.screen.clear_screen()\n    brain.screen.set_font(FontType.MONO20)\n    while True:\n        try:\n            main_pass()\n        except Exception as e:\n            # If anything goes wrong, the arm stops instead of running away,\n            # and the program keeps going.\n            print(e)\n            shoulder_motor.stop()\n            last_arm_cmd = \"stop\"\n        wait(20, MSEC)\n\ndrive_thread = Thread(drive_loop)\nwhen_started1()\n#endregion Startup\n","textLanguage":"python","robotConfig":[{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"","id":"primary"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}
